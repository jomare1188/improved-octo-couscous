// InterProScan 6.0.3.0 on the SGE cluster (no SGE profile ships with IPS6).
// Same rules as nf-rnaseq/conf_cluster/sge_cluster.config: memory is not a consumable here,
// so concurrency (queueSize) is what protects the hosts. telura is allowed (user OK, 2026-10-24).
process {
    executor       = 'sge'
    queue          = 'all.q'
    penv           = 'smp'
    clusterOptions = '-S /bin/bash -V'
    resourceLimits = [cpus: 8, memory: 64.GB, time: 48.h]

    // resources from the IPS6 'bulk' profile (larger batches need more RAM/time)
    withLabel: 'mem_low'      { memory = {  4.GB * task.attempt } }
    withLabel: 'mem_medium'   { memory = {  8.GB * task.attempt } }
    withLabel: 'mem_high'     { memory = { 16.GB * task.attempt } }
    withLabel: 'mem_veryhigh' { memory = { 32.GB * task.attempt } }
    withLabel: 'time_veryshort' { time = {  4.h * task.attempt } }   // SMART ~100 min per 3,000 seqs
    withLabel: 'time_short'   { time   = {  4.h * task.attempt } }
    withLabel: 'time_medium'  { time   = {  8.h * task.attempt } }
    withLabel: 'time_long'    { time   = { 12.h * task.attempt } }
    withName: 'RUN_PRINTS'               { memory = { 16.GB * task.attempt } }
    withName: 'RUN_PFSEARCH'             { time   = { 12.h  * task.attempt } }
    withName: 'REPRESENTATIVE_LOCATIONS' { memory = { 24.GB * task.attempt } }

    // Database downloads from EBI are slow here (~1 GB per 30-60 min); the default limit (~1 h)
    // killed PANTHER/CATH-size archives with exit 140 (SGE h_rt). Give them a day, 3 at a time.
    withName: 'DOWNLOAD_DATABASE|DOWNLOAD_INTERPRO' {
        time       = 24.h
        maxForks   = 3
        maxRetries = 2
    }
}

executor {
    name            = 'sge'
    queueSize       = 16            // at most 16 IPS jobs at once (dynamic tasks use --cpus 4 -> <=64 slots)
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
    exitReadTimeout = '10 min'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/Storage/data1/jorge.munoz/DOLORES/annotation/interproscan/singularity_cache'
    pullTimeout = '3 hours'
}
