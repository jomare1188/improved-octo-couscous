/*
 * SGE cluster config for nf-core/rnaseq (bioinfo.cluster, SGE 8.1.9)
 * Use: nextflow run nf-core/rnaseq -r 3.27.0 -profile singularity -c <this file> ...
 *
 * Notes on this cluster:
 *  - Only `slots` is consumable; there is NO memory consumable (h_vmem / mem_free /
 *    virtual_free are requestable but not consumable). Memory is therefore not reserved
 *    by SGE. Nextflow's SGE executor adds `-l virtual_free=<task.memory>`, which only
 *    makes SGE choose a host that currently has that much free memory.
 *    Do NOT request h_vmem: it is enforced as a ulimit on virtual memory and kills Java/Salmon.
 *  - PE `smp` has allocation_rule $pe_slots (all slots on one host) -> good for multithreaded tasks.
 *  - all.q has no h_rt / h_vmem limits.
 */

process {
    executor       = 'sge'
    queue          = 'all.q'
    penv           = 'smp'
    // -S: the queue shell is /bin/sh in posix_compliant mode; force bash.
    // -V: export the head job environment (PATH with singularity, NXF_* / SINGULARITY_* vars).
    // h=!telura*: keep heavy tasks off telura (it is the login node). Remove it to use telura too.
    clusterOptions = "-S /bin/bash -V -l h=!telura*"

    // Moderate caps per task (nf-core 'process_high' asks for 12 cpus / 72 GB; this caps anything higher).
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 168.h ]
}

executor {
    name              = 'sge'
    queueSize         = 10          // at most 10 tasks queued/running at once (moderate use)
    submitRateLimit   = '10/1min'   // be gentle with sge_qmaster
    pollInterval      = '30 sec'
    queueStatInterval = '1 min'
    exitReadTimeout   = '5 min'     // NFS latency when reading .exitcode
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/Storage/data1/jorge.munoz/DOLORES/nf-rnaseq/singularity_cache'
    pullTimeout = '60 min'
}
