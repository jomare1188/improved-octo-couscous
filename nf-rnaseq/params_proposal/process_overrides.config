/*
 * process_overrides.config — resource overrides for nf-core/rnaseq 3.27.0, Salmon-only on POJ2878
 * Use AFTER the cluster config:  -c conf_cluster/sge_cluster.config -c params_proposal/process_overrides.config
 * No executor settings here (the cluster agent provides those).
 *
 * 3.27.0 label defaults (conf/base.config):
 *   default         1 cpu   6 GB   4 h
 *   process_single  1 cpu   6 GB   4 h
 *   process_low     2 cpu  12 GB   4 h     (GFFREAD, FQ_LINT, FASTQC)
 *   process_medium  6 cpu  36 GB   8 h     (SALMON_INDEX, SALMON_QUANT, TXIMETA_TXIMPORT, DESEQ2_QC)
 *   process_high   12 cpu  72 GB  16 h     (MAKE_TRANSCRIPTS_FASTA = rsem-prepare-reference, SORTMERNA)
 *   process_high_memory 200 GB
 *   All values are multiplied by task.attempt. errorStrategy retries ONCE (maxRetries = 1), and only
 *   for exit codes 130-145/104/175-177 (137 = OOM kill); otherwise 'finish'.
 *   TRIMGALORE has its own setting: 8 cpu / 4 GB x attempt.
 *
 * Which steps are heavy here (10.37 Gb genome, 5,772 seqs, largest 131.7 Mb; 424,890 tx = 648.9 Mb):
 *   1. SALMON_INDEX with full-genome decoys. The gentrome is ~11.0 Gb. This is by far the heaviest step.
 *   2. SALMON_QUANT. It runs twice per sample: a 1M-read strandedness run
 *      (FASTQ_SUBSAMPLE_FQ_SALMON:SALMON_QUANT, --skipQuant) and the real quant. Both load the full index.
 *   3. MAKE_TRANSCRIPTS_FASTA (rsem-prepare-reference on 10.4 Gb), GUNZIP_FASTA (3.2 GB gz -> 10.4 GB),
 *      CUSTOM_GTFFILTER (Python scan of the 10.4 GB FASTA). These are I/O-bound and single-threaded.
 *   4. TXIMETA_TXIMPORT. 69 samples x 424,890 tx, plus bootstraps if --numBootstraps is set.
 *
 * Memory ESTIMATES. These are extrapolations, not measurements: Salmon 2.x on a 10 Gb polyploid has
 * not been benchmarked publicly. Reference points: salmon v2.7.0 notes, GRCh38 cDNA index build
 * peak 3.3 GB; salmon v2.2.1 notes, quant vs a human decoy-aware index 9.8-10 GB RSS; `salmon index
 * --ramLimit` default 8 GiB for the external minimizer sort (v2.3.2).
 *   no decoys  (649 Mb tx): build ~5-10 GB, <1-2 h;  index ~1-3 GB on disk;  quant ~3-8 GB RSS
 *   decoys (11.0 Gb gentrome): build ~30-80 GB, ~6-24 h, ~40-60 GB scratch in the work dir;
 *                              index ~10-25 GB;  quant ~15-35 GB RSS (alleles share k-mers, so
 *                              less than a 3.3x linear scale-up from human)
 *   -> Check the real peak_rss of SALMON_INDEX in pipeline_info/execution_trace_*.txt after the
 *      first run, then tighten SALMON_QUANT memory.
 *
 * SGE note (from the cluster config): memory is NOT a consumable on this cluster. task.memory only
 * makes Nextflow add `-l virtual_free=...` for host choice; it is not reserved. Concurrency is what
 * protects a host from OOM. The cluster config's queueSize = 12 with ~25-35 GB per quant stays well
 * under 500 GB per host, but maxForks is added on the big-memory steps as a second guard.
 */

process {

    // Overall per-task ceiling. Same values as the cluster config, repeated so that this file is
    // self-consistent if used alone. Retries can never ask for more than this.
    resourceLimits = [ cpus: 16, memory: 120.GB, time: 72.h ]

    // ---- Genome / annotation prep -----------------------------------------------------------
    withName: 'GUNZIP_FASTA' {            // 3.2 GB gz -> 10.4 GB; single-threaded gunzip, I/O bound
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withName: 'GFFREAD' {                 // GFF3 -> GTF only (no genome), 63 MB gz. Light.
        cpus   = 1
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: 'CUSTOM_GTFFILTER' {        // scans 10.4 GB FASTA headers + 2.5M-row GTF
        memory = { 8.GB * task.attempt }
        time   = { 6.h  * task.attempt }
    }
    withName: 'MAKE_TRANSCRIPTS_FASTA' {  // rsem-prepare-reference without an aligner: in practice
        cpus   = 2                        // single-threaded; memory ~ largest chromosome + 649 Mb tx.
        memory = { 24.GB * task.attempt } // (was process_high 12 cpu / 72 GB)
        time   = { 12.h  * task.attempt }
    }
    // If you switch to --gffread_transcript_fasta true, the step is GFFREAD_TRANSCRIPTS:
    withName: 'GFFREAD_TRANSCRIPTS' {
        cpus   = 1
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: 'SAMTOOLS_FAIDX' {
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // ---- Salmon index (decoy-aware by default) --------------------------------------------
    // Do NOT set ext.args here: the pipeline builds them (-k, --gencode, --extra_salmon_index_args)
    // under '.*:PREPARE_GENOME_INDICES:SALMON_INDEX', and an ext.args here would clobber them.
    // To use more RAM in the minimizer sort (faster, less disk spill), set
    // --extra_salmon_index_args '--ramLimit 32' instead.
    withName: '.*SALMON_INDEX' {
        cpus          = 16
        memory        = { 64.GB * task.attempt }   // pilot peak_rss 49.6 GB, 6 h; 120 GB (capped) on retry
        time          = { 48.h  * task.attempt }
        maxRetries    = 1
        maxForks      = 1
        // Without decoys (plan B, --transcript_fasta and no --fasta), this is plenty:
        // cpus = 8; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt }
    }

    // ---- Salmon quant (both the strandedness subsample run and the real quant) ----------------
    // Selector covers FASTQ_SUBSAMPLE_FQ_SALMON:SALMON_QUANT, QUANTIFY_PSEUDO_ALIGNMENT:SALMON_QUANT.
    // ext.args are not touched (libType + extra_salmon_quant_args come from the pipeline config).
    withName: '.*:SALMON_QUANT' {
        cpus     = 8                          // pilot: ~17% CPU, mostly loading the 60 GB index over NFS
        memory   = { 48.GB * task.attempt }   // pilot (2026-10-23) peak_rss 38.6 GB; 96 GB on retry
        time     = { 8.h   * task.attempt }   // pilot: 40 min/sample with 30 bootstraps + --gcBias
        maxForks = 4                          // 4 x 39 GB = ~155 GB worst case on one host; also spares NFS
        // Plan B (no decoys): memory = { 12.GB * task.attempt }
    }

    // ---- Trimming / QC (defaults are fine; listed for completeness) ---------------------------
    // TRIMGALORE: pipeline sets 8 cpu / 4 GB x attempt (PR #1905). No change.
    withName: 'FQ_LINT' {                     // reads both mates in lockstep; low memory, I/O bound
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // ---- Merge / tximport / DESeq2 QC ---------------------------------------------------------
    // tximport loads the inferential replicates for salmon (dropInfReps = FALSE):
    // 424,890 tx x 30 boots x 69 samples x 8 B ~ 7 GB, plus the count/TPM/length matrices.
    withName: '.*:TXIMETA_TXIMPORT' {
        cpus   = 2
        memory = { 48.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withName: '.*:CUSTOM_TX2GENE' {           // parses the 2.5M-row GTF
        memory = { 8.GB * task.attempt }
    }
    withName: 'DESEQ2_QC_PSEUDO' {            // ~398k genes x 69 samples, vst
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // ---- Only if rRNA removal is enabled ----------------------------------------------------
    withName: 'SORTMERNA' {                   // process_high by default; fast_db index is ~1-2 GB
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withName: '.*FASTQ_REMOVE_RRNA:BOWTIE2_ALIGN.*' {   // --ribo_removal_tool bowtie2 against small rRNA DB (only the rRNA step)
        cpus   = 8
        memory = { 8.GB * task.attempt }
    }
}
